# Скопировать в backend/.env и заполнить. Пустое значение = значение по умолчанию.

# Рабочие данные. По умолчанию — data/ в корне репозитория (gitignored). Держать в файловой системе WSL.
STUDIO_DATA_DIR=
LOG_LEVEL=INFO

# Ключи провайдеров — где взять, см. docs/api_keys.md
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# YouTube OAuth — не здесь: client_secret.json канала кладётся в data/channels/<channel>/oauth/
# (docs/api_keys.md, раздел YouTube).
