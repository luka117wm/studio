{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.api/project",
  "title": "project",
  "description": "Модели API Studio, группа «project». Сгенерировано из Pydantic.",
  "$defs": {
    "AnimateOverride": {
      "additionalProperties": false,
      "properties": {
        "recommended": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds"
        }
      },
      "title": "AnimateOverride",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "shot_id": {
          "anyOf": [
            {
              "pattern": "^s\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        },
        "kind": {
          "enum": [
            "image",
            "voice",
            "animation",
            "sfx",
            "music",
            "thumbnail",
            "render"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "stale",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "shot_id",
        "kind",
        "version",
        "path",
        "hash",
        "status"
      ],
      "title": "Asset",
      "type": "object"
    },
    "DirectorVersionInfo": {
      "additionalProperties": false,
      "description": "Строка индекса версий плана: хэш для дедупа повторного импорта и итог мёрджа.",
      "properties": {
        "version": {
          "pattern": "^v\\d{3}$",
          "title": "Version",
          "type": "string"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "imported_at": {
          "title": "Imported At",
          "type": "string"
        },
        "parts": {
          "minimum": 1,
          "title": "Parts",
          "type": "integer"
        },
        "source": {
          "default": "manual",
          "enum": [
            "bridge",
            "manual",
            "api"
          ],
          "title": "Source",
          "type": "string"
        },
        "shots": {
          "minimum": 0,
          "title": "Shots",
          "type": "integer"
        },
        "added": {
          "minimum": 0,
          "title": "Added",
          "type": "integer"
        },
        "changed": {
          "minimum": 0,
          "title": "Changed",
          "type": "integer"
        },
        "removed": {
          "minimum": 0,
          "title": "Removed",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "hash",
        "imported_at",
        "parts",
        "source",
        "shots",
        "added",
        "changed",
        "removed"
      ],
      "title": "DirectorVersionInfo",
      "type": "object"
    },
    "EpisodeBrief": {
      "additionalProperties": false,
      "description": "Заявка выпуска — вход промпта плана (устав M4, решение 5). Заполняется на экране 3 или\nиз идеи / референса. Что вернул чат — `director.brief`, это другая модель.",
      "properties": {
        "idea": {
          "default": "",
          "title": "Idea",
          "type": "string"
        },
        "angle": {
          "default": "",
          "title": "Angle",
          "type": "string"
        },
        "hook_promise": {
          "default": "",
          "title": "Hook Promise",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "idea_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idea Id"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "reference_mode": {
          "default": "none",
          "enum": [
            "none",
            "structure_clone",
            "own_version"
          ],
          "title": "Reference Mode",
          "type": "string"
        }
      },
      "required": [
        "idea",
        "angle",
        "hook_promise",
        "notes",
        "sources",
        "idea_id",
        "reference_id",
        "reference_mode"
      ],
      "title": "EpisodeBrief",
      "type": "object"
    },
    "ImageOverride": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "shot_size": {
          "anyOf": [
            {
              "enum": [
                "establishing",
                "action",
                "reaction",
                "detail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Size"
        }
      },
      "title": "ImageOverride",
      "type": "object"
    },
    "ImportResult": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "boolean"
        },
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "changed": {
          "title": "Changed",
          "type": "integer"
        },
        "removed": {
          "title": "Removed",
          "type": "integer"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ShotChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "version",
        "created",
        "added",
        "changed",
        "removed",
        "changes"
      ],
      "title": "ImportResult",
      "type": "object"
    },
    "MotionOverride": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "enum": [
                "push_in",
                "pull_out",
                "pan_left",
                "pan_right",
                "tilt_up",
                "tilt_down",
                "static",
                "drift"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "strength": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        },
        "ease": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "in_out_sine",
                "in_out_cubic",
                "in_cubic",
                "out_cubic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ease"
        }
      },
      "title": "MotionOverride",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "studio.project/1",
          "title": "Schema",
          "type": "string"
        },
        "episode_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Episode Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "brief": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeBrief"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "director_version": {
          "anyOf": [
            {
              "pattern": "^v\\d{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Director Version"
        },
        "director_versions": {
          "additionalProperties": {
            "$ref": "#/$defs/DirectorVersionInfo"
          },
          "default": {},
          "title": "Director Versions",
          "type": "object"
        },
        "approved_version": {
          "anyOf": [
            {
              "pattern": "^v\\d{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Version"
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "shots": {
          "additionalProperties": {
            "$ref": "#/$defs/ShotState"
          },
          "default": {},
          "title": "Shots",
          "type": "object"
        },
        "assets": {
          "additionalProperties": {
            "$ref": "#/$defs/Asset"
          },
          "default": {},
          "title": "Assets",
          "type": "object"
        },
        "timings": {
          "additionalProperties": {
            "$ref": "#/$defs/Timing"
          },
          "default": {},
          "title": "Timings",
          "type": "object"
        },
        "cost": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "title": "Cost",
          "type": "object"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "episode_id",
        "channel",
        "brief",
        "director_version",
        "director_versions",
        "shots",
        "assets",
        "timings",
        "cost",
        "updated_at"
      ],
      "title": "Project",
      "type": "object"
    },
    "SfxSpec": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "offset": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Offset",
          "type": "number"
        },
        "duration": {
          "exclusiveMinimum": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "gain_db": {
          "maximum": 0.0,
          "minimum": -40.0,
          "title": "Gain Db",
          "type": "number"
        }
      },
      "required": [
        "prompt",
        "offset",
        "duration",
        "gain_db"
      ],
      "title": "SfxSpec",
      "type": "object"
    },
    "ShotChange": {
      "additionalProperties": false,
      "description": "Строка таблицы расхождений (ConflictBar, экран 10).",
      "properties": {
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section"
        },
        "kind": {
          "enum": [
            "added",
            "changed",
            "removed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "change": {
          "title": "Change",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "drawn_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawn At"
        },
        "price": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        }
      },
      "required": [
        "shot_id",
        "section",
        "kind",
        "change",
        "fields",
        "stale",
        "drawn_at",
        "price"
      ],
      "title": "ShotChange",
      "type": "object"
    },
    "ShotOverride": {
      "additionalProperties": false,
      "description": "Ручные правки полей кадра поверх плана. `sfx` заменяется целиком.",
      "properties": {
        "vo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vo"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/MotionOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transition_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "animate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimateOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sfx": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SfxSpec"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sfx"
        }
      },
      "title": "ShotOverride",
      "type": "object"
    },
    "ShotState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "todo",
          "enum": [
            "todo",
            "queued",
            "generating",
            "done",
            "failed",
            "stale",
            "removed"
          ],
          "title": "Status",
          "type": "string"
        },
        "duration_locked": {
          "default": false,
          "title": "Duration Locked",
          "type": "boolean"
        },
        "prompt_locked": {
          "default": false,
          "title": "Prompt Locked",
          "type": "boolean"
        },
        "user_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stale_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stale Reasons",
          "type": "array"
        }
      },
      "required": [
        "status",
        "duration_locked",
        "prompt_locked",
        "user_override",
        "stale_reasons"
      ],
      "title": "ShotState",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "Source",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "pattern": "^s\\d{3,}$",
          "title": "Shot Id",
          "type": "string"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "exclusiveMinimum": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "source": {
          "enum": [
            "voice",
            "locked",
            "estimate"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "shot_id",
        "start",
        "duration",
        "source"
      ],
      "title": "Timing",
      "type": "object"
    },
    "TransitionOverride": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "enum": [
                "cut",
                "crossfade",
                "dip"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        }
      },
      "title": "TransitionOverride",
      "type": "object"
    }
  }
}
