{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.api/plan",
  "title": "plan",
  "description": "Модели API Studio, группа «plan». Сгенерировано из Pydantic.",
  "$defs": {
    "AnchorSheet": {
      "description": "Лист опорных портретов облика для версии персонажа: выбрано ракурсов из шести (M5.4).",
      "properties": {
        "status": {
          "enum": [
            "missing",
            "partial",
            "ready",
            "outdated"
          ],
          "title": "Status",
          "type": "string"
        },
        "chosen": {
          "title": "Chosen",
          "type": "integer"
        },
        "total": {
          "default": 6,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "chosen",
        "total"
      ],
      "title": "AnchorSheet",
      "type": "object"
    },
    "AnimateSpec": {
      "additionalProperties": false,
      "properties": {
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "seconds": {
          "default": 4,
          "maximum": 10,
          "minimum": 2,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "recommended",
        "reason",
        "prompt",
        "seconds"
      ],
      "title": "AnimateSpec",
      "type": "object"
    },
    "ApprovalProblem": {
      "properties": {
        "check": {
          "enum": [
            "stage",
            "plan",
            "vo",
            "prompt",
            "similarity",
            "canon"
          ],
          "title": "Check",
          "type": "string"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shot Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "canon": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "check",
        "shot_id",
        "message"
      ],
      "title": "ApprovalProblem",
      "type": "object"
    },
    "ApprovalRefusal": {
      "description": "Тело 409 «Утвердить план» (`detail`): сводка для пользователя и проблемы по кадрам.",
      "properties": {
        "code": {
          "const": "plan_not_ready",
          "default": "plan_not_ready",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/ApprovalProblem"
          },
          "title": "Problems",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "problems"
      ],
      "title": "ApprovalRefusal",
      "type": "object"
    },
    "BridgeIssue": {
      "description": "Одна ошибка внутри ответа: где (`shots[3].image.prompt`, `s012`) и что не так.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "title": "BridgeIssue",
      "type": "object"
    },
    "BridgeRun": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "task": {
          "enum": [
            "plan",
            "ideas",
            "reference"
          ],
          "title": "Task",
          "type": "string"
        },
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode Id"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "integer"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "part": {
          "minimum": 1,
          "title": "Part",
          "type": "integer"
        },
        "parts_total": {
          "minimum": 1,
          "title": "Parts Total",
          "type": "integer"
        },
        "status": {
          "enum": [
            "prompted",
            "applied",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/BridgeIssue"
          },
          "title": "Errors",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "answered_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answered At"
        }
      },
      "required": [
        "id",
        "task",
        "channel",
        "episode_id",
        "target_id",
        "prompt_id",
        "prompt_version",
        "prompt_hash",
        "part",
        "parts_total",
        "status",
        "errors",
        "created_at",
        "answered_at"
      ],
      "title": "BridgeRun",
      "type": "object"
    },
    "BudgetOutlook": {
      "description": "Уровень бюджета после выпуска: лимит, занятое до него, доля сметы, остаток.",
      "properties": {
        "level": {
          "enum": [
            "month",
            "episode",
            "animation"
          ],
          "title": "Level",
          "type": "string"
        },
        "limit": {
          "$ref": "#/$defs/Money"
        },
        "committed": {
          "$ref": "#/$defs/Money"
        },
        "estimate": {
          "$ref": "#/$defs/Money"
        },
        "remaining": {
          "$ref": "#/$defs/Money"
        },
        "exceeded": {
          "title": "Exceeded",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "level",
        "limit",
        "committed",
        "estimate",
        "remaining",
        "exceeded",
        "message"
      ],
      "title": "BudgetOutlook",
      "type": "object"
    },
    "CanonProblem": {
      "properties": {
        "kind": {
          "enum": [
            "style",
            "period",
            "appearance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "issue": {
          "enum": [
            "unpublished",
            "unresolved",
            "no_sheet",
            "sheet_incomplete",
            "sheet_outdated"
          ],
          "title": "Issue",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "issue",
        "message"
      ],
      "title": "CanonProblem",
      "type": "object"
    },
    "CanonTarget": {
      "description": "Что не готово в каноне выпуска: сущность и вид проблемы.",
      "properties": {
        "kind": {
          "enum": [
            "style",
            "period",
            "appearance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "issue": {
          "enum": [
            "unpublished",
            "unresolved",
            "no_sheet",
            "sheet_incomplete",
            "sheet_outdated"
          ],
          "title": "Issue",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "issue"
      ],
      "title": "CanonTarget",
      "type": "object"
    },
    "CostLine": {
      "properties": {
        "unit": {
          "enum": [
            "image",
            "char",
            "second",
            "token_in",
            "token_out",
            "search"
          ],
          "title": "Unit",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        },
        "usd_micro": {
          "title": "Usd Micro",
          "type": "integer"
        }
      },
      "required": [
        "unit",
        "quantity",
        "variant",
        "usd_micro"
      ],
      "title": "CostLine",
      "type": "object"
    },
    "EffectivePlan": {
      "additionalProperties": false,
      "description": "Действующий план для экрана 3: текущая версия плюс ручные правки.\n\n`shots` — кадры версии по таймлайну, затем убранные (`status: removed`) с содержимым из\nпоследней версии, где они были (принцип 8).",
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "bridge",
            "manual",
            "api"
          ],
          "title": "Source",
          "type": "string"
        },
        "approved_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Version"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/PlanShot"
          },
          "title": "Shots",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "version",
        "source",
        "approved_version",
        "meta",
        "sections",
        "shots",
        "facts"
      ],
      "title": "EffectivePlan",
      "type": "object"
    },
    "EpisodeAppearanceItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "pinned": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pinned"
        },
        "latest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest"
        },
        "status": {
          "enum": [
            "missing",
            "draft_only",
            "ready",
            "outdated"
          ],
          "title": "Status",
          "type": "string"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "draft": {
          "title": "Draft",
          "type": "boolean"
        },
        "shots": {
          "title": "Shots",
          "type": "integer"
        },
        "sheet": {
          "$ref": "#/$defs/AnchorSheet"
        }
      },
      "required": [
        "id",
        "ref",
        "pinned",
        "latest",
        "status",
        "resolved",
        "draft",
        "shots",
        "sheet"
      ],
      "title": "EpisodeAppearanceItem",
      "type": "object"
    },
    "EpisodeCanon": {
      "description": "Канон выпуска для экрана 3 (`GET /api/projects/{id}/canon`).",
      "properties": {
        "plan_version": {
          "title": "Plan Version",
          "type": "string"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        },
        "updatable": {
          "title": "Updatable",
          "type": "boolean"
        },
        "style": {
          "$ref": "#/$defs/EpisodeCanonItem"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/EpisodeCanonItem"
          },
          "title": "Periods",
          "type": "array"
        },
        "appearances": {
          "items": {
            "$ref": "#/$defs/EpisodeAppearanceItem"
          },
          "title": "Appearances",
          "type": "array"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/CanonProblem"
          },
          "title": "Problems",
          "type": "array"
        }
      },
      "required": [
        "plan_version",
        "ready",
        "updatable",
        "style",
        "periods",
        "appearances",
        "problems"
      ],
      "title": "EpisodeCanon",
      "type": "object"
    },
    "EpisodeCanonItem": {
      "description": "Стиль, эпоха или облик из `canon_ref` плана.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "pinned": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pinned"
        },
        "latest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest"
        },
        "status": {
          "enum": [
            "missing",
            "draft_only",
            "ready",
            "outdated"
          ],
          "title": "Status",
          "type": "string"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "draft": {
          "title": "Draft",
          "type": "boolean"
        },
        "shots": {
          "title": "Shots",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "ref",
        "pinned",
        "latest",
        "status",
        "resolved",
        "draft",
        "shots"
      ],
      "title": "EpisodeCanonItem",
      "type": "object"
    },
    "EstimateLine": {
      "description": "Строка сметы плана для экрана: что, сколько и почём.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "usd": {
          "$ref": "#/$defs/Money"
        },
        "cost": {
          "$ref": "#/$defs/StageCost"
        }
      },
      "required": [
        "title",
        "label",
        "usd",
        "cost"
      ],
      "title": "EstimateLine",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "disputed",
            "not_found"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "shot_id": {
          "anyOf": [
            {
              "pattern": "^s\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        }
      },
      "required": [
        "claim",
        "status",
        "source_url"
      ],
      "title": "Fact",
      "type": "object"
    },
    "ImageSpec": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "period": {
          "title": "Period",
          "type": "string"
        },
        "appearances": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Appearances",
          "type": "array"
        },
        "shot_size": {
          "enum": [
            "establishing",
            "action",
            "reaction",
            "detail"
          ],
          "title": "Shot Size",
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "period",
        "appearances",
        "shot_size"
      ],
      "title": "ImageSpec",
      "type": "object"
    },
    "ImportResult": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "boolean"
        },
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "changed": {
          "title": "Changed",
          "type": "integer"
        },
        "removed": {
          "title": "Removed",
          "type": "integer"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ShotChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "version",
        "created",
        "added",
        "changed",
        "removed",
        "changes"
      ],
      "title": "ImportResult",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "episode_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Episode Id",
          "type": "string"
        },
        "working_title": {
          "title": "Working Title",
          "type": "string"
        },
        "format": {
          "enum": [
            "every_rank",
            "host"
          ],
          "title": "Format",
          "type": "string"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "target_minutes": {
          "maximum": 40,
          "minimum": 1,
          "title": "Target Minutes",
          "type": "integer"
        },
        "part": {
          "default": 1,
          "minimum": 1,
          "title": "Part",
          "type": "integer"
        },
        "parts_total": {
          "default": 1,
          "minimum": 1,
          "title": "Parts Total",
          "type": "integer"
        }
      },
      "required": [
        "channel",
        "episode_id",
        "working_title",
        "format",
        "language",
        "target_minutes",
        "part",
        "parts_total"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Money": {
      "description": "Деньги в ответе API: по `usd_micro` считать, `usd` показывать.",
      "properties": {
        "usd_micro": {
          "title": "Usd Micro",
          "type": "integer"
        },
        "usd": {
          "title": "Usd",
          "type": "string"
        }
      },
      "required": [
        "usd_micro",
        "usd"
      ],
      "title": "Money",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "push_in",
            "pull_out",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down",
            "static",
            "drift"
          ],
          "title": "Type",
          "type": "string"
        },
        "strength": {
          "maximum": 0.25,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "ease": {
          "enum": [
            "linear",
            "in_out_sine",
            "in_out_cubic",
            "in_cubic",
            "out_cubic"
          ],
          "title": "Ease",
          "type": "string"
        }
      },
      "required": [
        "type",
        "strength",
        "ease"
      ],
      "title": "Motion",
      "type": "object"
    },
    "PlanAnswer": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PlanAnswer",
      "type": "object"
    },
    "PlanAnswerResult": {
      "description": "Часть принята: что дальше — следующая часть или итог импорта версии.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "integer"
        },
        "parts_total": {
          "title": "Parts Total",
          "type": "integer"
        },
        "shots_in_part": {
          "title": "Shots In Part",
          "type": "integer"
        },
        "received": {
          "items": {
            "type": "integer"
          },
          "title": "Received",
          "type": "array"
        },
        "next_part": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Part"
        },
        "import_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "part",
        "parts_total",
