{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.api/plan",
  "title": "plan",
  "description": "Модели API Studio, группа «plan». Сгенерировано из Pydantic.",
  "$defs": {
    "BridgeIssue": {
      "description": "Одна ошибка внутри ответа: где (`shots[3].image.prompt`, `s012`) и что не так.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "title": "BridgeIssue",
      "type": "object"
    },
    "BridgeRun": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "task": {
          "enum": [
            "plan",
            "ideas",
            "reference"
          ],
          "title": "Task",
          "type": "string"
        },
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode Id"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "integer"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "part": {
          "minimum": 1,
          "title": "Part",
          "type": "integer"
        },
        "parts_total": {
          "minimum": 1,
          "title": "Parts Total",
          "type": "integer"
        },
        "status": {
          "enum": [
            "prompted",
            "applied",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/BridgeIssue"
          },
          "title": "Errors",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "answered_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answered At"
        }
      },
      "required": [
        "id",
        "task",
        "channel",
        "episode_id",
        "target_id",
        "prompt_id",
        "prompt_version",
        "prompt_hash",
        "part",
        "parts_total",
        "status",
        "errors",
        "created_at",
        "answered_at"
      ],
      "title": "BridgeRun",
      "type": "object"
    },
    "ImportResult": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "boolean"
        },
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "changed": {
          "title": "Changed",
          "type": "integer"
        },
        "removed": {
          "title": "Removed",
          "type": "integer"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ShotChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "version",
        "created",
        "added",
        "changed",
        "removed",
        "changes"
      ],
      "title": "ImportResult",
      "type": "object"
    },
    "PlanAnswer": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PlanAnswer",
      "type": "object"
    },
    "PlanAnswerResult": {
      "description": "Часть принята: что дальше — следующая часть или итог импорта версии.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "integer"
        },
        "parts_total": {
          "title": "Parts Total",
          "type": "integer"
        },
        "shots_in_part": {
          "title": "Shots In Part",
          "type": "integer"
        },
        "received": {
          "items": {
            "type": "integer"
          },
          "title": "Received",
          "type": "array"
        },
        "next_part": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Part"
        },
        "import_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "part",
        "parts_total",
        "shots_in_part",
        "received",
        "next_part",
        "import_result",
        "warnings"
      ],
      "title": "PlanAnswerResult",
      "type": "object"
    },
    "PlanParts": {
      "description": "Состояние набора частей для панели моста на экране 3.",
      "properties": {
        "parts_total": {
          "title": "Parts Total",
          "type": "integer"
        },
        "shots_per_part": {
          "title": "Shots Per Part",
          "type": "integer"
        },
        "received": {
          "items": {
            "type": "integer"
          },
          "title": "Received",
          "type": "array"
        },
        "next_part": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Part"
        },
        "last_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/BridgeRun"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "parts_total",
        "shots_per_part",
        "received",
        "next_part",
        "last_run"
      ],
      "title": "PlanParts",
      "type": "object"
    },
    "PlanPrompt": {
      "description": "Промпт части для кнопки «Скопировать»; обмен открыт (`run_id`).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "integer"
        },
        "parts_total": {
          "title": "Parts Total",
          "type": "integer"
        },
        "first_shot": {
          "title": "First Shot",
          "type": "string"
        },
        "last_shot": {
          "title": "Last Shot",
          "type": "string"
        }
      },
      "required": [
        "text",
        "prompt_id",
        "version",
        "run_id",
        "part",
        "parts_total",
        "first_shot",
        "last_shot"
      ],
      "title": "PlanPrompt",
      "type": "object"
    },
    "ShotChange": {
      "additionalProperties": false,
      "description": "Строка таблицы расхождений (ConflictBar, экран 10).",
      "properties": {
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section"
        },
        "kind": {
          "enum": [
            "added",
            "changed",
            "removed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "change": {
          "title": "Change",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "drawn_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawn At"
        },
        "price": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        }
      },
      "required": [
        "shot_id",
        "section",
        "kind",
        "change",
        "fields",
        "stale",
        "drawn_at",
        "price"
      ],
      "title": "ShotChange",
      "type": "object"
    }
  }
}
