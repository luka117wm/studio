    "Character": {
      "additionalProperties": false,
      "description": "Персонаж — один файл версии на всех обликов; ссылка на облик —\n`characters/<персонаж>/vNNN#<облик>`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "nature": {
          "$ref": "#/$defs/Nature",
          "default": {
            "personality": "",
            "posture": "",
            "manner": "",
            "face": ""
