{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.api/canon",
  "title": "canon",
  "description": "Модели API Studio, группа «canon». Сгенерировано из Pydantic.",
  "$defs": {
    "AnchorCandidate": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ready",
            "rejected",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ref"
        },
        "usd": {
          "$ref": "#/$defs/Money"
        },
        "cached": {
          "title": "Cached",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "n",
        "status",
        "file",
        "error",
        "seed",
        "version",
        "ref",
        "usd",
        "cached",
        "created_at"
      ],
      "title": "AnchorCandidate",
      "type": "object"
    },
    "AnchorSetState": {
      "description": "Лист облика (`GET …/appearances/{id}/anchors`) или кадры стиля (`GET …/style/anchors`).",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        },
        "status": {
          "enum": [
            "missing",
            "partial",
            "ready",
            "outdated"
          ],
          "title": "Status",
          "type": "string"
        },
        "chosen": {
          "title": "Chosen",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "stale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stale"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/AnchorSlot"
          },
          "title": "Slots",
          "type": "array"
        },
        "spent": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "channel",
        "target",
        "version",
        "status",
        "chosen",
        "total",
        "stale",
        "slots",
        "spent"
      ],
      "title": "AnchorSetState",
      "type": "object"
    },
    "AnchorSlot": {
      "description": "Ракурс листа или шаблон кадра стиля.",
      "properties": {
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/AnchorCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "chosen": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChosenAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stale"
        }
      },
      "required": [
        "slot",
        "label",
        "hint",
        "candidates",
        "chosen",
        "stale"
      ],
      "title": "AnchorSlot",
      "type": "object"
    },
    "AnchorsEstimate": {
      "description": "Цена до клика (`GET …/anchors/estimate`): лист, ракурс, кадры стиля и устаревшие ракурсы\nлиста облика (`null` — устаревших нет или смета без облика).",
      "properties": {
        "sheet": {
          "$ref": "#/$defs/EstimateLine"
        },
        "angle": {
          "$ref": "#/$defs/EstimateLine"
        },
        "style": {
          "$ref": "#/$defs/EstimateLine"
        },
        "stale": {
          "anyOf": [
            {
              "$ref": "#/$defs/EstimateLine"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sheet",
        "angle",
        "style",
        "stale"
      ],
      "title": "AnchorsEstimate",
      "type": "object"
    },
    "Appearance": {
      "additionalProperties": false,
      "description": "Облик: персонаж в одной эпохе и одном возрасте. Свой лист опорных портретов.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "period": {
          "default": "",
          "title": "Period",
          "type": "string"
        },
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "build": {
          "default": "",
          "title": "Build",
          "type": "string"
        },
        "face": {
          "default": "",
          "title": "Face",
          "type": "string"
        },
        "hair": {
          "default": "",
          "title": "Hair",
          "type": "string"
        },
        "clothing": {
          "default": "",
          "title": "Clothing",
          "type": "string"
        },
        "wear": {
          "default": "",
          "title": "Wear",
          "type": "string"
        },
        "props": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Props",
          "type": "array"
        },
        "negative_local": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Negative Local",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "period",
        "age",
        "build",
        "face",
        "hair",
        "clothing",
        "wear",
        "props",
        "negative_local"
      ],
      "title": "Appearance",
      "type": "object"
    },
    "AppearanceCopy": {
      "additionalProperties": false,
      "description": "Тело «Копировать облик в другую эпоху»: эпоха и id нового облика того же персонажа.",
      "properties": {
        "period": {
          "title": "Period",
          "type": "string"
        },
        "appearance_id": {
          "title": "Appearance Id",
          "type": "string"
        }
      },
      "required": [
        "period",
        "appearance_id"
      ],
      "title": "AppearanceCopy",
      "type": "object"
    },
    "CandidatePick": {
      "additionalProperties": false,
      "description": "Тело «Выбрать» и «Отбраковать»: id кандидата из состояния листа.",
      "properties": {
        "candidate": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidate",
          "type": "string"
        }
      },
      "required": [
        "candidate"
      ],
      "title": "CandidatePick",
      "type": "object"
    },
    "CanonCharacterItem": {
      "additionalProperties": false,
      "description": "Подпись и число обликов — из черновика, а без него — из последней версии.\n`sheets_ready` — у скольких из этих обликов лист опорных портретов готов 6/6 и не устарел\nпротив последней опубликованной версии с обликом; считает `episode_canon.canon_overview`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/CanonVersionInfo"
          },
          "title": "Versions",
          "type": "array"
        },
        "draft": {
          "title": "Draft",
          "type": "boolean"
        },
        "appearances_count": {
          "title": "Appearances Count",
          "type": "integer"
        },
        "sheets_ready": {
          "default": 0,
          "title": "Sheets Ready",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "versions",
        "draft",
        "appearances_count",
        "sheets_ready"
      ],
      "title": "CanonCharacterItem",
      "type": "object"
    },
    "CanonNeeded": {
      "description": "«Нужно каналу» (`GET /api/canon/{channel}/needed`): эпохи и облики из `canon_ref` текущих\nверсий планов, у которых нет ни одной опубликованной версии.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/NeededItem"
          },
          "title": "Periods",
          "type": "array"
        },
        "appearances": {
          "items": {
            "$ref": "#/$defs/NeededAppearance"
          },
          "title": "Appearances",
          "type": "array"
        }
      },
      "required": [
        "channel",
        "periods",
        "appearances"
      ],
      "title": "CanonNeeded",
      "type": "object"
    },
    "CanonPeriodItem": {
      "additionalProperties": false,
      "description": "Подпись, регион, годы и число запретов — из черновика, а без него — из последней версии.\n`episodes` — сколько выпусков ссылаются на эпоху текущими планами (`canon_ref` или кадры);\nсчитает `episode_canon.canon_overview`, хранилище оставляет 0.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "years": {
          "anyOf": [
            {
              "$ref": "#/$defs/Years"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/CanonVersionInfo"
          },
          "title": "Versions",
          "type": "array"
        },
        "draft": {
          "title": "Draft",
          "type": "boolean"
        },
        "forbidden_count": {
          "title": "Forbidden Count",
          "type": "integer"
        },
        "episodes": {
          "default": 0,
          "title": "Episodes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "region",
        "years",
        "versions",
        "draft",
        "forbidden_count",
        "episodes"
      ],
      "title": "CanonPeriodItem",
      "type": "object"
    },
    "CanonStyleSummary": {
      "additionalProperties": false,
      "properties": {
        "versions": {
          "items": {
            "$ref": "#/$defs/CanonVersionInfo"
          },
