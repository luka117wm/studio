{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.api/canon",
  "title": "canon",
  "description": "Модели API Studio, группа «canon». Сгенерировано из Pydantic.",
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "description": "Облик: персонаж в одной эпохе и одном возрасте. Свой лист опорных портретов.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "period": {
          "default": "",
          "title": "Period",
          "type": "string"
        },
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "build": {
          "default": "",
          "title": "Build",
          "type": "string"
        },
        "face": {
          "default": "",
          "title": "Face",
          "type": "string"
        },
        "hair": {
          "default": "",
          "title": "Hair",
          "type": "string"
        },
        "clothing": {
          "default": "",
          "title": "Clothing",
          "type": "string"
        },
        "wear": {
          "default": "",
          "title": "Wear",
          "type": "string"
        },
        "props": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Props",
          "type": "array"
        },
        "negative_local": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Negative Local",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "period",
        "age",
        "build",
        "face",
        "hair",
        "clothing",
        "wear",
        "props",
        "negative_local"
      ],
      "title": "Appearance",
      "type": "object"
    },
    "CanonCharacterItem": {
      "additionalProperties": false,
      "description": "Подпись и число обликов — из черновика, а без него — из последней версии.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/CanonVersionInfo"
          },
          "title": "Versions",
          "type": "array"
        },
        "draft": {
          "title": "Draft",
          "type": "boolean"
        },
        "appearances_count": {
          "title": "Appearances Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "versions",
        "draft",
        "appearances_count"
