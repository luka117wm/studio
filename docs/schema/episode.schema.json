{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.api/episode",
  "title": "episode",
  "description": "Модели API Studio, группа «episode». Сгенерировано из Pydantic.",
  "$defs": {
    "Episode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "short_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Title"
        },
        "origin": {
          "enum": [
            "backlog",
            "reference",
            "blank"
          ],
          "title": "Origin",
          "type": "string"
        },
        "stage": {
          "enum": [
            "idea",
            "script",
            "generate",
            "edit",
            "export",
            "publish"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "generating",
            "warning",
            "ready",
            "failed",
            "published"
          ],
          "title": "Status",
          "type": "string"
        },
        "slot_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Date"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "channel",
        "title",
        "short_title",
        "origin",
        "stage",
        "status",
        "slot_date",
        "created_at",
        "updated_at"
      ],
      "title": "Episode",
      "type": "object"
    },
    "EpisodeCreate": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "title": {
          "default": "Новый выпуск",
          "title": "Title",
          "type": "string"
        },
        "short_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Title"
        },
        "origin": {
          "default": "blank",
          "enum": [
            "backlog",
            "reference",
            "blank"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "channel"
      ],
      "title": "EpisodeCreate",
      "type": "object"
    },
    "EpisodeJob": {
      "additionalProperties": false,
      "description": "Джоб, который сейчас занят выпуском.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "title": "Progress",
          "type": "number"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Message"
        }
      },
      "required": [
        "kind",
        "status",
        "progress",
        "message"
      ],
      "title": "EpisodeJob",
      "type": "object"
    },
    "EpisodeListItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "cursus",
            "otto"
          ],
          "title": "Channel",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "short_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Title"
        },
        "origin": {
          "enum": [
            "backlog",
            "reference",
            "blank"
          ],
          "title": "Origin",
          "type": "string"
        },
        "stage": {
          "enum": [
            "idea",
            "script",
            "generate",
            "edit",
            "export",
            "publish"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "generating",
            "warning",
            "ready",
            "failed",
            "published"
          ],
          "title": "Status",
          "type": "string"
        },
        "slot_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Date"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/EpisodeSummary"
        }
      },
      "required": [
        "id",
        "channel",
        "title",
        "short_title",
        "origin",
        "stage",
        "status",
        "slot_date",
        "created_at",
        "updated_at",
        "summary"
      ],
      "title": "EpisodeListItem",
      "type": "object"
    },
    "EpisodePatch": {
      "additionalProperties": false,
      "description": "Переименование. Поля нет в теле — не меняется; `short_title: null` — сбросить.",
      "properties": {
        "title": {
          "default": null,
          "title": "Title",
          "type": "string"
        },
        "short_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Title"
        }
      },
      "title": "EpisodePatch",
      "type": "object"
    },
    "EpisodeSummary": {
      "additionalProperties": false,
      "properties": {
        "shots_total": {
          "title": "Shots Total",
          "type": "integer"
        },
        "shots_done": {
          "title": "Shots Done",
          "type": "integer"
        },
        "shots_failed": {
          "title": "Shots Failed",
          "type": "integer"
        },
        "shots_stale": {
          "title": "Shots Stale",
          "type": "integer"
        },
        "shots_generating": {
          "title": "Shots Generating",
          "type": "integer"
        },
        "vo_words": {
          "title": "Vo Words",
          "type": "integer"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration S"
        },
        "duration_source": {
          "anyOf": [
            {
              "enum": [
                "voice",
                "estimate",
                "target"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Source"
        },
        "spent_usd_micro": {
          "title": "Spent Usd Micro",
          "type": "integer"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeJob"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shots_total",
        "shots_done",
        "shots_failed",
        "shots_stale",
        "shots_generating",
        "vo_words",
        "duration_s",
        "duration_source",
        "spent_usd_micro",
        "job"
      ],
      "title": "EpisodeSummary",
      "type": "object"
    }
  }
}
